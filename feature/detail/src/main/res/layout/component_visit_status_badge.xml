<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutStatusBadge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp"
    tools:ignore="UseCompoundDrawables">

    <!-- Status indicator circle dot (shown for pending, hidden for visited if checkmark text is used) -->
    <View
        android:id="@+id/viewStatusDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/status_visited_text"
        android:textStyle="bold"
        tools:text="✓ Visited 09:15 AM" />
</LinearLayout>
