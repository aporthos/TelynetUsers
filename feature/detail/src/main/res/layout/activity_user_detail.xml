<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_surface">

    <!-- Top App Bar with Back Navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_light_surface"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Contact Detail"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgDetailPhoto"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                        tools:srcCompat="@tools:sample/avatars" />

                    <TextView
                        android:id="@+id/tvDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Elena Rostova" />

                    <include
                        android:id="@+id/includeDetailStatus"
                        layout="@layout/component_visit_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Actions: Call Mobile & Directions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallMobile"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Call Mobile"
                    app:backgroundTint="@color/md_theme_light_primary"
                    app:icon="@android:drawable/ic_menu_call"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Corner16" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirections"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Directions"
                    app:icon="@android:drawable/ic_dialog_map"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Corner16" />
            </LinearLayout>

            <!-- Field Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Field Location"
                        android:textColor="@color/status_visited_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLocationAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="742 Evergreen Terrace" />

                    <TextView
                        android:id="@+id/tvLocationSuite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textSize="14sp"
                        tools:text="Suite 400, Springfield, OR 97477" />

                    <!-- Google Maps Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartNavigation"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="Start Navigation in Google Maps"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Corner16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Credentials Card with Copy Action -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact Credentials"
                        android:textColor="@color/md_theme_light_onSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Phone row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Direct Mobile"
                                android:textColor="@color/md_theme_light_onSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvCredentialPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/md_theme_light_onSurface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="+1 (555) 234-8901" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyPhone"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy phone number"
                            android:src="@android:drawable/ic_menu_save" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/md_theme_light_outline" />

                    <!-- Email row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Corporate Email"
                                android:textColor="@color/md_theme_light_onSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvCredentialEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/md_theme_light_onSurface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="elena.rostova@acme.com" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyEmail"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy email address"
                            android:src="@android:drawable/ic_menu_save" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>